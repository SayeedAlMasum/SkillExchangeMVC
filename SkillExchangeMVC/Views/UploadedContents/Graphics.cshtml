@{
    ViewData["Title"] = "Graphics Design";
    var course = ViewBag.Course as SkillExchangeMVC.Models.Course;
    var courseId = ViewBag.CourseId as int?;
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <!-- Course Navigation -->
            @if (course != null)
            {
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">Courses</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })">@course.Title</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Graphics Design</li>
                    </ol>
                </nav>
                
                <div class="alert alert-info">
                    <strong>Course:</strong> @course.Title <br>
                    <strong>Category:</strong> @course.Category - @course.SubCategory
                </div>
            }

            <h2>Graphics Design</h2>
            <p>This page contains content related to Graphics Design principles and techniques.</p>
            
            <div class="content-section">
                <div class="card">
                    <div class="card-header">
                        <h4>Graphics Design Fundamentals</h4>
                    </div>
                    <div class="card-body">
                        <h5>What is Graphics Design?</h5>
                        <p>Graphics design is the art and science of combining text, images, and ideas to communicate messages effectively to audiences. It involves creating visual content to communicate messages.</p>
                        
                        <h5>Design Principles</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-primary text-white">
                                        <h6>Balance</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Distribution of visual weight in a design. Can be symmetrical, asymmetrical, or radial.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-success text-white">
                                        <h6>Contrast</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Difference between design elements to create visual interest and draw attention.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-warning text-dark">
                                        <h6>Emphasis</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Creating a focal point to guide the viewer's attention to important elements.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-info text-white">
                                        <h6>Movement</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Guiding the viewer's eye through the design using lines, shapes, and colors.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-danger text-white">
                                        <h6>Proportion</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Relationship between the sizes of different elements in the design.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-secondary text-white">
                                        <h6>Unity</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Harmony between all elements to create a cohesive design.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Color Theory</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Color Wheel</h6>
                                <ul>
                                    <li><strong>Primary Colors:</strong> Red, Blue, Yellow</li>
                                    <li><strong>Secondary Colors:</strong> Green, Orange, Purple</li>
                                    <li><strong>Tertiary Colors:</strong> Mix of primary and secondary</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6>Color Schemes</h6>
                                <ul>
                                    <li><strong>Monochromatic:</strong> Different shades of one color</li>
                                    <li><strong>Complementary:</strong> Opposite colors on color wheel</li>
                                    <li><strong>Analogous:</strong> Adjacent colors on color wheel</li>
                                    <li><strong>Triadic:</strong> Three evenly spaced colors</li>
                                </ul>
                            </div>
                        </div>

                        <h5>Typography</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Font Categories</h6>
                                <ul>
                                    <li><strong>Serif:</strong> Traditional fonts with decorative strokes</li>
                                    <li><strong>Sans-serif:</strong> Clean, modern fonts without decorative strokes</li>
                                    <li><strong>Script:</strong> Cursive or handwritten style fonts</li>
                                    <li><strong>Display:</strong> Decorative fonts for headlines</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6>Typography Guidelines</h6>
                                <ul>
                                    <li>Limit to 2-3 fonts per design</li>
                                    <li>Ensure readability and legibility</li>
                                    <li>Consider hierarchy with font sizes</li>
                                    <li>Maintain consistent spacing</li>
                                </ul>
                            </div>
                        </div>

                        <h5>Popular Design Software</h5>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Adobe Photoshop</h6>
                                        <p>Photo editing and digital art</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Adobe Illustrator</h6>
                                        <p>Vector graphics and logos</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Adobe InDesign</h6>
                                        <p>Layout and print design</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Figma</h6>
                                        <p>UI/UX design and prototyping</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-4">
                @if (course != null)
                {
                    <a href="@Url.Action("CPlusPlus", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Previous: C++
                    </a>
                    <a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Course Contents
                    </a>
                    <a href="@Url.Action("VideoEditing", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-primary">
                        Next: Video Editing <i class="fas fa-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>