@{
    ViewData["Title"] = "Entrepreneurship";
    var course = ViewBag.Course as SkillExchangeMVC.Models.Course;
    var courseId = ViewBag.CourseId as int?;
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <!-- Course Navigation -->
            @if (course != null)
            {
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">Courses</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })">@course.Title</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Entrepreneurship</li>
                    </ol>
                </nav>
                
                <div class="alert alert-info">
                    <strong>Course:</strong> @course.Title <br>
                    <strong>Category:</strong> @course.Category - @course.SubCategory
                </div>
            }

            <h2>Entrepreneurship</h2>
            <p>Learn about business planning, startup strategies, innovation, and leadership skills.</p>
            
            <div class="content-section">
                <div class="card">
                    <div class="card-header">
                        <h4>Entrepreneurship Fundamentals</h4>
                    </div>
                    <div class="card-body">
                        <h5>What is Entrepreneurship?</h5>
                        <p>Entrepreneurship is the process of creating, developing, and managing a business venture to make a profit while taking on financial risks.</p>
                        
                        <h5>Key Entrepreneurial Traits</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <ul>
                                    <li><strong>Risk-taking:</strong> Willingness to take calculated risks</li>
                                    <li><strong>Innovation:</strong> Creating new solutions and ideas</li>
                                    <li><strong>Persistence:</strong> Continuing despite obstacles</li>
                                    <li><strong>Vision:</strong> Seeing opportunities others miss</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul>
                                    <li><strong>Leadership:</strong> Inspiring and guiding teams</li>
                                    <li><strong>Adaptability:</strong> Adjusting to changing conditions</li>
                                    <li><strong>Passion:</strong> Strong commitment to the venture</li>
                                    <li><strong>Resourcefulness:</strong> Making the most of limited resources</li>
                                </ul>
                            </div>
                        </div>

                        <h5>Business Planning Process</h5>
                        <div class="accordion" id="businessPlanAccordion">
                            <div class="accordion-item">
                                <h6 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                        1. Business Idea & Market Research
                                    </button>
                                </h6>
                                <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#businessPlanAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>Identify market problems and opportunities</li>
                                            <li>Research target audience and competitors</li>
                                            <li>Validate your business idea</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h6 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                        2. Business Model Development
                                    </button>
                                </h6>
                                <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#businessPlanAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>Define value proposition</li>
                                            <li>Determine revenue streams</li>
                                            <li>Plan cost structure</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h6 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                        3. Financial Planning
                                    </button>
                                </h6>
                                <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#businessPlanAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>Create financial projections</li>
                                            <li>Determine funding requirements</li>
                                            <li>Plan cash flow management</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Funding Options</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Bootstrapping</h6>
                                        <p>Self-funding from personal savings</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Angel Investors</h6>
                                        <p>Wealthy individuals investing in startups</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Venture Capital</h6>
                                        <p>Professional investment firms</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Success Metrics</h5>
                        <div class="alert alert-success">
                            <h6><i class="fas fa-chart-line"></i> Key Performance Indicators</h6>
                            <ul class="mb-0">
                                <li><strong>Revenue Growth:</strong> Track sales increase over time</li>
                                <li><strong>Customer Acquisition Cost:</strong> Cost to acquire new customers</li>
                                <li><strong>Customer Lifetime Value:</strong> Total value from customer relationship</li>
                                <li><strong>Market Share:</strong> Percentage of total market captured</li>
                                <li><strong>Profit Margins:</strong> Profitability of products/services</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-4">
                @if (course != null)
                {
                    <a href="@Url.Action("Marketing", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Previous: Marketing
                    </a>
                    <a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Course Contents
                    </a>
                    <a href="@Url.Action("Leadership", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-primary">
                        Next: Leadership <i class="fas fa-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>