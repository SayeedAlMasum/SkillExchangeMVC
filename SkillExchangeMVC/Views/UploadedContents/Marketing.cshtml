@{
    ViewData["Title"] = "Marketing";
    var course = ViewBag.Course as SkillExchangeMVC.Models.Course;
    var courseId = ViewBag.CourseId as int?;
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <!-- Course Navigation -->
            @if (course != null)
            {
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">Courses</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })">@course.Title</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Marketing</li>
                    </ol>
                </nav>
                
                <div class="alert alert-info">
                    <strong>Course:</strong> @course.Title <br>
                    <strong>Category:</strong> @course.Category - @course.SubCategory
                </div>
            }

            <h2>Marketing</h2>
            <p>Learn about marketing strategies, digital marketing, branding, and customer engagement.</p>
            
            <div class="content-section">
                <div class="card">
                    <div class="card-header">
                        <h4>Marketing Fundamentals</h4>
                    </div>
                    <div class="card-body">
                        <h5>4 P's of Marketing</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-primary text-white">
                                        <h6>Product</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>What you're selling - goods or services that meet customer needs.</p>
                                    </div>
                                </div>
                                <div class="card mb-3">
                                    <div class="card-header bg-success text-white">
                                        <h6>Price</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>How much customers pay - pricing strategy affects demand and profit.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-warning text-dark">
                                        <h6>Place</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Where you sell - distribution channels and locations.</p>
                                    </div>
                                </div>
                                <div class="card mb-3">
                                    <div class="card-header bg-info text-white">
                                        <h6>Promotion</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>How you communicate - advertising, PR, and marketing communications.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Digital Marketing Channels</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Social Media Marketing</h6>
                                        <p>Facebook, Instagram, Twitter, LinkedIn, TikTok</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Search Engine Optimization</h6>
                                        <p>Improving website visibility in search results</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Email Marketing</h6>
                                        <p>Direct communication with customers and prospects</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Content Marketing</h5>
                        <div class="alert alert-info">
                            <h6><i class="fas fa-content"></i> Content Types</h6>
                            <ul class="mb-0">
                                <li><strong>Blog Posts:</strong> Educational and informative articles</li>
                                <li><strong>Videos:</strong> Tutorials, testimonials, and product demos</li>
                                <li><strong>Infographics:</strong> Visual representation of data and concepts</li>
                                <li><strong>Podcasts:</strong> Audio content for engaged audiences</li>
                                <li><strong>Case Studies:</strong> Success stories and results</li>
                            </ul>
                        </div>

                        <h5>Customer Journey</h5>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h6>Marketing Funnel Stages</h6>
                                    </div>
                                    <div class="card-body">
                                        <ol>
                                            <li><strong>Awareness:</strong> Customer becomes aware of your brand</li>
                                            <li><strong>Interest:</strong> Customer shows interest in your products/services</li>
                                            <li><strong>Consideration:</strong> Customer evaluates your offering</li>
                                            <li><strong>Purchase:</strong> Customer makes a buying decision</li>
                                            <li><strong>Retention:</strong> Customer becomes repeat buyer</li>
                                            <li><strong>Advocacy:</strong> Customer recommends your brand to others</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-4">
                @if (course != null)
                {
                    <a href="@Url.Action("Photography", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Previous: Photography
                    </a>
                    <a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Course Contents
                    </a>
                    <a href="@Url.Action("Entrepreneurship", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-primary">
                        Next: Entrepreneurship <i class="fas fa-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>