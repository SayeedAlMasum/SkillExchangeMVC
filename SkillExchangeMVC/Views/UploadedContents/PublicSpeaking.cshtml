@{
    ViewData["Title"] = "Public Speaking";
    var course = ViewBag.Course as SkillExchangeMVC.Models.Course;
    var courseId = ViewBag.CourseId as int?;
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <!-- Course Navigation -->
            @if (course != null)
            {
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">Courses</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })">@course.Title</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Public Speaking</li>
                    </ol>
                </nav>
                
                <div class="alert alert-info">
                    <strong>Course:</strong> @course.Title <br>
                    <strong>Category:</strong> @course.Category - @course.SubCategory
                </div>
            }

            <h2>Public Speaking</h2>
            <p>Learn about presentation skills, confidence building, storytelling, and audience engagement.</p>
            
            <div class="content-section">
                <div class="card">
                    <div class="card-header">
                        <h4>Public Speaking Fundamentals</h4>
                    </div>
                    <div class="card-body">
                        <h5>Overcoming Speaking Anxiety</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Common Fears</h6>
                                <ul>
                                    <li>Fear of judgment</li>
                                    <li>Fear of forgetting content</li>
                                    <li>Fear of technical issues</li>
                                    <li>Fear of questions</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6>Confidence Building Techniques</h6>
                                <ul>
                                    <li>Practice extensively</li>
                                    <li>Know your material inside out</li>
                                    <li>Visualize success</li>
                                    <li>Start with smaller audiences</li>
                                </ul>
                            </div>
                        </div>

                        <h5>Speech Structure</h5>
                        <div class="card">
                            <div class="card-header">
                                <h6>Classic Speech Format</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="card mb-3">
                                            <div class="card-header bg-primary text-white">
                                                <h6>Introduction (10%)</h6>
                                            </div>
                                            <div class="card-body">
                                                <ul>
                                                    <li>Hook/Attention grabber</li>
                                                    <li>Introduce yourself</li>
                                                    <li>Preview main points</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-3">
                                            <div class="card-header bg-success text-white">
                                                <h6>Body (80%)</h6>
                                            </div>
                                            <div class="card-body">
                                                <ul>
                                                    <li>Main points (2-3 max)</li>
                                                    <li>Supporting evidence</li>
                                                    <li>Clear transitions</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-3">
                                            <div class="card-header bg-warning text-dark">
                                                <h6>Conclusion (10%)</h6>
                                            </div>
                                            <div class="card-body">
                                                <ul>
                                                    <li>Summarize key points</li>
                                                    <li>Call to action</li>
                                                    <li>Memorable closing</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Engaging Your Audience</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Verbal Techniques</h6>
                                <ul>
                                    <li><strong>Vary your pace:</strong> Speed up and slow down for emphasis</li>
                                    <li><strong>Use pauses:</strong> Strategic silence for impact</li>
                                    <li><strong>Vocal variety:</strong> Change tone and volume</li>
                                    <li><strong>Clear articulation:</strong> Speak clearly and distinctly</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6>Non-Verbal Communication</h6>
                                <ul>
                                    <li><strong>Eye contact:</strong> Connect with your audience</li>
                                    <li><strong>Gestures:</strong> Use hand movements naturally</li>
                                    <li><strong>Posture:</strong> Stand confidently and tall</li>
                                    <li><strong>Facial expressions:</strong> Match your emotions to content</li>
                                </ul>
                            </div>
                        </div>

                        <h5>Storytelling Techniques</h5>
                        <div class="alert alert-info">
                            <h6><i class="fas fa-book-open"></i> Elements of Great Stories</h6>
                            <ul class="mb-0">
                                <li><strong>Relatable Character:</strong> Someone audience can connect with</li>
                                <li><strong>Conflict or Challenge:</strong> A problem that needs solving</li>
                                <li><strong>Journey:</strong> The process of overcoming the challenge</li>
                                <li><strong>Resolution:</strong> How the problem was solved</li>
                                <li><strong>Lesson or Moral:</strong> What can be learned from the story</li>
                            </ul>
                        </div>

                        <h5>Handling Questions and Interactions</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Q&A Best Practices</h6>
                                <ul>
                                    <li>Listen to the complete question</li>
                                    <li>Repeat or paraphrase the question</li>
                                    <li>Answer honestly and concisely</li>
                                    <li>It's okay to say "I don't know"</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6>Handling Difficult Questions</h6>
                                <ul>
                                    <li>Stay calm and composed</li>
                                    <li>Acknowledge the question's validity</li>
                                    <li>Bridge to your key messages</li>
                                    <li>Offer to follow up later if needed</li>
                                </ul>
                            </div>
                        </div>

                        <h5>Presentation Technology</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Slide Design</h6>
                                        <p>Keep slides simple with minimal text and high-quality visuals</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Backup Plans</h6>
                                        <p>Always have backup files and be ready to present without slides</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Interactive Tools</h6>
                                        <p>Use polls, Q&A platforms, and audience response systems</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Practice and Preparation</h5>
                        <div class="card">
                            <div class="card-header">
                                <h6>Preparation Checklist</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6>Content Preparation</h6>
                                        <ul>
                                            <li>Research your topic thoroughly</li>
                                            <li>Know your audience</li>
                                            <li>Create clear objectives</li>
                                            <li>Practice out loud multiple times</li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <h6>Logistics Preparation</h6>
                                        <ul>
                                            <li>Test all technology beforehand</li>
                                            <li>Arrive early to set up</li>
                                            <li>Have water available</li>
                                            <li>Prepare backup materials</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-4">
                @if (course != null)
                {
                    <a href="@Url.Action("Leadership", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Previous: Leadership
                    </a>
                    <a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Course Contents
                    </a>
                }
            </div>
        </div>
    </div>
</div>