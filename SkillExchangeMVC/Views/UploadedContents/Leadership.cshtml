@{
    ViewData["Title"] = "Leadership";
    var course = ViewBag.Course as SkillExchangeMVC.Models.Course;
    var courseId = ViewBag.CourseId as int?;
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <!-- Course Navigation -->
            @if (course != null)
            {
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">Courses</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })">@course.Title</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Leadership</li>
                    </ol>
                </nav>
                
                <div class="alert alert-info">
                    <strong>Course:</strong> @course.Title <br>
                    <strong>Category:</strong> @course.Category - @course.SubCategory
                </div>
            }

            <h2>Leadership</h2>
            <p>Learn about leadership principles, team management, decision-making, and communication skills.</p>
            
            <div class="content-section">
                <div class="card">
                    <div class="card-header">
                        <h4>Leadership Fundamentals</h4>
                    </div>
                    <div class="card-body">
                        <h5>Leadership Styles</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-primary text-white">
                                        <h6>Transformational Leadership</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Inspires and motivates followers to achieve extraordinary outcomes and develop their own leadership capacity.</p>
                                    </div>
                                </div>
                                <div class="card mb-3">
                                    <div class="card-header bg-success text-white">
                                        <h6>Servant Leadership</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Focuses on serving others first and helping them grow and perform as highly as possible.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-warning text-dark">
                                        <h6>Democratic Leadership</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Involves team members in decision-making and encourages participation and collaboration.</p>
                                    </div>
                                </div>
                                <div class="card mb-3">
                                    <div class="card-header bg-info text-white">
                                        <h6>Situational Leadership</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Adapts leadership style based on the situation and the maturity level of followers.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Core Leadership Skills</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Communication</h6>
                                        <p>Clear, effective communication with all team members</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Decision Making</h6>
                                        <p>Making informed, timely decisions under pressure</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Emotional Intelligence</h6>
                                        <p>Understanding and managing emotions effectively</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Team Management</h5>
                        <div class="alert alert-info">
                            <h6><i class="fas fa-users"></i> Effective Team Management Tips</h6>
                            <ul class="mb-0">
                                <li><strong>Set Clear Goals:</strong> Define objectives and expectations</li>
                                <li><strong>Foster Collaboration:</strong> Encourage teamwork and cooperation</li>
                                <li><strong>Provide Feedback:</strong> Regular constructive feedback and recognition</li>
                                <li><strong>Delegate Effectively:</strong> Assign tasks based on strengths</li>
                                <li><strong>Build Trust:</strong> Create an environment of mutual respect</li>
                            </ul>
                        </div>

                        <h5>Leadership Development</h5>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h6>Personal Development Plan</h6>
                                    </div>
                                    <div class="card-body">
                                        <ol>
                                            <li><strong>Self-Assessment:</strong> Identify strengths and areas for improvement</li>
                                            <li><strong>Seek Feedback:</strong> Get input from colleagues and mentors</li>
                                            <li><strong>Continuous Learning:</strong> Stay updated with leadership trends and best practices</li>
                                            <li><strong>Practice:</strong> Apply leadership skills in real situations</li>
                                            <li><strong>Mentoring:</strong> Both seek mentors and mentor others</li>
                                            <li><strong>Reflect:</strong> Regularly evaluate your leadership effectiveness</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Conflict Resolution</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Steps to Resolve Conflicts</h6>
                                <ol>
                                    <li>Identify the problem</li>
                                    <li>Listen to all parties</li>
                                    <li>Find common ground</li>
                                    <li>Brainstorm solutions</li>
                                    <li>Agree on action steps</li>
                                    <li>Follow up</li>
                                </ol>
                            </div>
                            <div class="col-md-6">
                                <h6>Conflict Resolution Strategies</h6>
                                <ul>
                                    <li><strong>Collaboration:</strong> Work together to find win-win solutions</li>
                                    <li><strong>Compromise:</strong> Both parties give up something</li>
                                    <li><strong>Accommodation:</strong> One party yields to the other</li>
                                    <li><strong>Competition:</strong> Assertive approach when quick decisions are needed</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-4">
                @if (course != null)
                {
                    <a href="@Url.Action("Entrepreneurship", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Previous: Entrepreneurship
                    </a>
                    <a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Course Contents
                    </a>
                    <a href="@Url.Action("PublicSpeaking", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-primary">
                        Next: Public Speaking <i class="fas fa-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>