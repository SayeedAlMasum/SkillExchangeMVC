@{
    ViewData["Title"] = "Photography";
    var course = ViewBag.Course as SkillExchangeMVC.Models.Course;
    var courseId = ViewBag.CourseId as int?;
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <!-- Course Navigation -->
            @if (course != null)
            {
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">Courses</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })">@course.Title</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Photography</li>
                    </ol>
                </nav>
                
                <div class="alert alert-info">
                    <strong>Course:</strong> @course.Title <br>
                    <strong>Category:</strong> @course.Category - @course.SubCategory
                </div>
            }

            <h2>Photography</h2>
            <p>Learn about photography techniques, composition, lighting, and camera settings.</p>
            
            <div class="content-section">
                <div class="card">
                    <div class="card-header">
                        <h4>Photography Fundamentals</h4>
                    </div>
                    <div class="card-body">
                        <h5>Camera Basics</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-primary text-white">
                                        <h6>Aperture (f-stop)</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Controls depth of field</p>
                                        <ul>
                                            <li>Lower f-number = wider aperture</li>
                                            <li>f/1.4-f/2.8: Shallow depth</li>
                                            <li>f/8-f/11: Sharp landscapes</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-success text-white">
                                        <h6>Shutter Speed</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Controls motion blur</p>
                                        <ul>
                                            <li>Fast (1/500s): Freeze motion</li>
                                            <li>Slow (1/30s): Motion blur</li>
                                            <li>Bulb mode: Long exposures</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card mb-3">
                                    <div class="card-header bg-warning text-dark">
                                        <h6>ISO</h6>
                                    </div>
                                    <div class="card-body">
                                        <p>Controls light sensitivity</p>
                                        <ul>
                                            <li>ISO 100-400: Bright conditions</li>
                                            <li>ISO 800-1600: Low light</li>
                                            <li>Higher ISO = more noise</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Composition Rules</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Rule of Thirds</h6>
                                <p>Divide your frame into nine equal sections and place important elements along these lines or at their intersections.</p>
                                
                                <h6>Leading Lines</h6>
                                <p>Use lines in your composition to guide the viewer's eye to the main subject.</p>
                                
                                <h6>Framing</h6>
                                <p>Use natural elements to create a frame around your subject.</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Symmetry and Patterns</h6>
                                <p>Look for symmetrical compositions or repeating patterns in your environment.</p>
                                
                                <h6>Fill the Frame</h6>
                                <p>Get closer to your subject to eliminate distracting elements.</p>
                                
                                <h6>Negative Space</h6>
                                <p>Use empty space around your subject to create emphasis and breathing room.</p>
                            </div>
                        </div>

                        <h5>Types of Photography</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Portrait Photography</h6>
                                        <p>Capturing people and their personalities</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Landscape Photography</h6>
                                        <p>Capturing natural environments and scenery</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Street Photography</h6>
                                        <p>Candid moments in public spaces</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>Lighting Techniques</h5>
                        <div class="alert alert-info">
                            <h6><i class="fas fa-lightbulb"></i> Lighting Tips</h6>
                            <ul class="mb-0">
                                <li><strong>Golden Hour:</strong> 1 hour after sunrise and before sunset</li>
                                <li><strong>Blue Hour:</strong> Just after sunset for dramatic skies</li>
                                <li><strong>Harsh Light:</strong> Midday sun creates strong shadows</li>
                                <li><strong>Diffused Light:</strong> Overcast skies provide even lighting</li>
                                <li><strong>Artificial Light:</strong> Flash, LED panels, and reflectors</li>
                            </ul>
                        </div>

                        <h5>Post-Processing Software</h5>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Adobe Lightroom</h6>
                                        <p>RAW processing and organization</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Adobe Photoshop</h6>
                                        <p>Advanced editing and retouching</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>Capture One</h6>
                                        <p>Professional RAW processor</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h6>GIMP</h6>
                                        <p>Free alternative to Photoshop</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="mt-4">
                @if (course != null)
                {
                    <a href="@Url.Action("VideoEditing", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Previous: Video Editing
                    </a>
                    <a href="@Url.Action("CourseContents", "Content", new { courseId = course.CourseId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Course Contents
                    </a>
                    <a href="@Url.Action("Marketing", "UploadedContents", new { courseId = course.CourseId })" class="btn btn-primary">
                        Next: Marketing <i class="fas fa-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>