@using System.Security.Claims
@model IEnumerable<SkillExchangeMVC.Models.Content>
@{
    var course = ViewBag.Course as SkillExchangeMVC.Models.Course;
    ViewData["Title"] = $"{course?.Title} - Course Content";
}

<div class="course-content-page">
  @Html.AntiForgeryToken()
    
  @* Hero Section with Course Title *@
    <div class="course-hero">
  <div class="container">
            <div class="row align-items-center">
           <div class="col-lg-8">
 <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-3">
              <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">All Courses</a></li>
           <li class="breadcrumb-item"><a href="@Url.Action("IndexCourse", "Course")">@course?.Category</a></li>
         <li class="breadcrumb-item active" aria-current="page">@course?.Title</li>
      </ol>
     </nav>
    <h1 class="course-title">@course?.Title</h1>
     <p class="course-description">@course?.Description</p>
       
      <div class="course-meta d-flex flex-wrap gap-3 mt-3">
 <span class="meta-item">
         <i class="fas fa-folder text-primary"></i> 
        <strong>@course?.Category</strong>
         </span>
    <span class="meta-item">
      <i class="fas fa-tag text-info"></i> 
 @course?.SubCategory
  </span>
            @if (course?.IsPremium ?? false)
       {
    <span class="badge bg-warning text-dark px-3 py-2">
               <i class="fas fa-crown"></i> Premium Course
                 </span>
         }
           else
     {
           <span class="badge bg-success px-3 py-2">
         <i class="fas fa-gift"></i> Free Course
</span>
      }
     </div>
      </div>
         <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
       <a href="@Url.Action("IndexCourse", "Course")" class="btn btn-outline-light">
           <i class="fas fa-arrow-left"></i> Back to Courses
       </a>
     </div>
       </div>
        </div>
    </div>

 @* Alerts *@
 <div class="container mt-3">
        @if (TempData["Error"] != null)
    {
            <div class="alert alert-danger alert-dismissible fade show">
          <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
     <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
        }
@if (TempData["Success"] != null)
        {
    <div class="alert alert-success alert-dismissible fade show">
     <i class="fas fa-check-circle"></i> @TempData["Success"]
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
     </div>
        }
    </div>

    @* Main Content Area *@
    <div class="container mt-4 mb-5">
        <div class="row">
   @* Learning Topics Section *@
            @if (course != null)
            {
       var courseTitle = course.Title.ToLower();
             bool hasSpecificContent = courseTitle.Contains("c#") || courseTitle.Contains("java") || 
             courseTitle.Contains("c++") || courseTitle.Contains("graphic") ||
         courseTitle.Contains("video") || courseTitle.Contains("photo") ||
 courseTitle.Contains("marketing") || courseTitle.Contains("entrepreneur") ||
      courseTitle.Contains("leader");

  @if (hasSpecificContent)
          {
 <div class="col-12 mb-4">
            <div class="section-header">
      <h3><i class="fas fa-book-reader"></i> Learning Topics</h3>
           <p class="text-muted">Explore curated learning materials for this course</p>
  </div>

        <div class="row g-3">
  @* C# *@
        @if (courseTitle.Contains("c#") || courseTitle.Contains("csharp"))
{
         <div class="col-md-6 col-lg-4">
   <a href="@Url.Action("CSharpMethods", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
              <div class="topic-icon bg-primary">
           <i class="fas fa-code"></i>
     </div>
            <div class="topic-content">
         <h5>C# Methods</h5>
       <p>Learn about methods and functions</p>
        </div>
   <i class="fas fa-arrow-right topic-arrow"></i>
        </a>
       </div>
<div class="col-md-6 col-lg-4">
         <a href="@Url.Action("CSharpOOP", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
    <div class="topic-icon bg-primary">
             <i class="fas fa-cubes"></i>
                </div>
       <div class="topic-content">
          <h5>C# OOP</h5>
        <p>Object-Oriented Programming concepts</p>
             </div>
      <i class="fas fa-arrow-right topic-arrow"></i>
        </a>
       </div>
              }

 @* Java *@
    @if (courseTitle.Contains("java"))
       {
 <div class="col-md-6 col-lg-4">
      <a href="@Url.Action("Java", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
              <div class="topic-icon" style="background-color: #ff6600;">
         <i class="fas fa-coffee"></i>
         </div>
       <div class="topic-content">
           <h5>Java Programming</h5>
       <p>Master Java programming fundamentals</p>
        </div>
          <i class="fas fa-arrow-right topic-arrow"></i>
          </a>
        </div>
     }

           @* C++ *@
       @if (courseTitle.Contains("c++"))
   {
            <div class="col-md-6 col-lg-4">
    <a href="@Url.Action("CPlusPlus", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
    <div class="topic-icon bg-dark">
             <i class="fas fa-terminal"></i>
  </div>
   <div class="topic-content">
      <h5>C++ Programming</h5>
     <p>Learn C++ programming essentials</p>
    </div>
        <i class="fas fa-arrow-right topic-arrow"></i>
             </a>
      </div>
  }

       @* Graphics Design *@
           @if (courseTitle.Contains("graphic"))
           {
         <div class="col-md-6 col-lg-4">
            <a href="@Url.Action("Graphics", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
             <div class="topic-icon bg-success">
<i class="fas fa-palette"></i>
    </div>
    <div class="topic-content">
                <h5>Graphics Design</h5>
  <p>Create stunning visual designs</p>
    </div>
        <i class="fas fa-arrow-right topic-arrow"></i>
       </a>
   </div>
          }

          @* Video Editing *@
              @if (courseTitle.Contains("video"))
     {
  <div class="col-md-6 col-lg-4">
       <a href="@Url.Action("VideoEditing", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
              <div class="topic-icon bg-info">
  <i class="fas fa-video"></i>
          </div>
           <div class="topic-content">
 <h5>Video Editing</h5>
          <p>Master video editing techniques</p>
        </div>
   <i class="fas fa-arrow-right topic-arrow"></i>
          </a>
         </div>
     }

       @* Photography *@
     @if (courseTitle.Contains("photo"))
              {
              <div class="col-md-6 col-lg-4">
  <a href="@Url.Action("Photography", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
         <div class="topic-icon bg-warning">
        <i class="fas fa-camera"></i>
   </div>
    <div class="topic-content">
    <h5>Photography</h5>
     <p>Capture amazing photographs</p>
     </div>
         <i class="fas fa-arrow-right topic-arrow"></i>
         </a>
        </div>
                  }

    @* Marketing *@
       @if (courseTitle.Contains("marketing"))
             {
             <div class="col-md-6 col-lg-4">
  <a href="@Url.Action("Marketing", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
      <div class="topic-icon bg-primary">
        <i class="fas fa-bullhorn"></i>
     </div>
   <div class="topic-content">
            <h5>Marketing</h5>
            <p>Strategic marketing techniques</p>
         </div>
                 <i class="fas fa-arrow-right topic-arrow"></i>
   </a>
     </div>
          }

      @* Entrepreneurship *@
          @if (courseTitle.Contains("entrepreneur"))
         {
           <div class="col-md-6 col-lg-4">
             <a href="@Url.Action("Entrepreneurship", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
              <div class="topic-icon bg-success">
              <i class="fas fa-lightbulb"></i>
    </div>
<div class="topic-content">
          <h5>Entrepreneurship</h5>
 <p>Build your business skills</p>
 </div>
            <i class="fas fa-arrow-right topic-arrow"></i>
             </a>
       </div>
      }

     @* Leadership *@
  @if (courseTitle.Contains("leader"))
                {
        <div class="col-md-6 col-lg-4">
         <a href="@Url.Action("Leadership", "UploadedContents", new { courseId = course.CourseId })" class="topic-card">
    <div class="topic-icon bg-info">
   <i class="fas fa-users"></i>
   </div>
     <div class="topic-content">
  <h5>Leadership</h5>
        <p>Develop leadership qualities</p>
   </div>
        <i class="fas fa-arrow-right topic-arrow"></i>
         </a>
       </div>
           }
   </div>
</div>
 }
   }

     @* Course Materials Section *@
          <div class="col-12">
     <div class="section-header">
   <h3><i class="fas fa-folder-open"></i> Course Materials</h3>
       <p class="text-muted">Download resources and materials for this course</p>
      </div>

       @if (Model.Any())
           {
            <div class="materials-grid">
              @foreach (var c in Model)
          {
       <div class="material-card">
        <div class="material-icon">
           @if (c.Type == "PDF")
      {
   <i class="fas fa-file-pdf text-danger"></i>
          }
 else if (c.Type == "Video")
        {
            <i class="fas fa-video text-primary"></i>
  }
             else
             {
            <i class="fas fa-link text-success"></i>
        }
          </div>
    <div class="material-info">
           <h5>@c.Title</h5>
   <p class="text-muted">@c.Description</p>
         <span class="badge bg-light text-dark">@c.Type</span>
       </div>
           <div class="material-actions">
          @if (c.Type == "Link")
        {
    <a href="@Url.Action("DownloadContent", "Content", new { contentId = c.ContentId })" 
  target="_blank" class="btn btn-primary btn-sm">
       <i class="fas fa-external-link-alt"></i> Open
      </a>
}
     else
     {
    <a href="@Url.Action("DownloadContent", "Content", new { contentId = c.ContentId })" 
           class="btn btn-success btn-sm" download>
<i class="fas fa-download"></i> Download
                </a>
             }

   @if (User.IsInRole("Admin") || (User.IsInRole("Teacher") && c.UploaderEmail == User.FindFirstValue(ClaimTypes.Email)))
    {
     <button type="button" class="btn btn-danger btn-sm" 
         onclick="deleteCourseContent(@c.ContentId, '@c.Title')">
          <i class="fas fa-trash"></i>
        </button>
   }
            </div>
      </div>
  }
        </div>
         }
    else
 {
         <div class="empty-state">
     <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
           <h5>No materials uploaded yet</h5>
         <p class="text-muted">Course materials will appear here once they are added</p>
              </div>
    }
</div>
   </div>
    </div>
</div>

<style>
    .course-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 40px 0;
        margin-bottom: 30px;
    }

    .course-title {
     font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .course-description {
   font-size: 1.1rem;
        opacity: 0.95;
    }

    .course-meta .meta-item {
        background: rgba(255,255,255,0.2);
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.95rem;
    }

    .breadcrumb {
     background: rgba(255,255,255,0.1);
        padding: 10px 15px;
        border-radius: 8px;
    }

    .breadcrumb-item a {
     color: rgba(255,255,255,0.9);
        text-decoration: none;
    }

    .breadcrumb-item.active {
        color: white;
    }

    .section-header {
        margin-bottom: 25px;
    }

    .section-header h3 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .topic-card {
        display: flex;
  align-items: center;
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
text-decoration: none;
        color: inherit;
        position: relative;
     overflow: hidden;
    }

 .topic-card:hover {
  transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .topic-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
     border-radius: 10px;
        color: white;
        font-size: 1.5rem;
        margin-right: 15px;
        flex-shrink: 0;
}

    .topic-content h5 {
        margin: 0 0 5px;
        font-size: 1.1rem;
        font-weight: 600;
     color: #2c3e50;
    }

    .topic-content p {
        margin: 0;
        font-size: 0.9rem;
        color: #6c757d;
    }

    .topic-arrow {
        margin-left: auto;
        color: #dee2e6;
        transition: all 0.3s ease;
    }

    .topic-card:hover .topic-arrow {
        color: #667eea;
   transform: translateX(5px);
    }

    .materials-grid {
        display: grid;
gap: 20px;
    }

  .material-card {
        display: flex;
        align-items: center;
        padding: 20px;
     background: white;
        border-radius: 12px;
   box-shadow: 0 2px 8px rgba(0,0,0,0.08);
   transition: all 0.3s ease;
    }

    .material-card:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.12);
}

    .material-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
     border-radius: 10px;
        font-size: 1.8rem;
    margin-right: 20px;
        flex-shrink: 0;
    }

    .material-info {
        flex-grow: 1;
    }

    .material-info h5 {
        margin: 0 0 8px;
   font-size: 1.1rem;
        font-weight: 600;
        color: #2c3e50;
    }

 .material-info p {
    margin: 0 0 8px;
        font-size: 0.9rem;
    }

    .material-actions {
        display: flex;
        gap: 8px;
    }

  .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
    }

    .empty-state i {
   opacity: 0.3;
    }

    @@media (max-width: 768px) {
    .course-title {
        font-size: 1.8rem;
    }

        .material-card {
    flex-direction: column;
            text-align: center;
        }

  .material-icon {
 margin: 0 0 15px 0;
        }

  .material-actions {
     width: 100%;
      justify-content: center;
   margin-top: 15px;
    }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 <script>
function deleteCourseContent(contentId, contentTitle) {
       Swal.fire({
     title: 'Delete Material?',
    text: `Are you sure you want to delete "${contentTitle}"?`,
      icon: 'warning',
 showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it',
   cancelButtonText: 'Cancel'
   }).then((result) => {
         if (result.isConfirmed) {
          Swal.fire({
       title: 'Deleting...',
            allowOutsideClick: false,
  didOpen: () => { Swal.showLoading(); }
      });

  $.ajax({
           url: '@Url.Action("DeleteCourseContent", "Content")',
              type: 'POST',
        data: { contentId: contentId },
         headers: {
             'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
              },
                  success: function (response) {
          if (response.success) {
   Swal.fire({
     title: 'Deleted!',
              text: response.message,
          icon: 'success'
          }).then(() => location.reload());
    } else {
 Swal.fire('Error!', response.message, 'error');
      }
         },
            error: function () {
  Swal.fire('Error!', 'Failed to delete content', 'error');
          }
     });
   }
            });
  }
    </script>
}
