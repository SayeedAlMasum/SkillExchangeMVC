@* Upload Content *@
@model SkillExchangeMVC.Models.Content
@{
    ViewData["Title"] = "Upload Content";
}
<div class="mt-3">
    <a asp-action="IndexContent" class="btn btn-outline-info">Manage Uploaded Content</a>
</div>

<h2>Upload Content</h2>

<form asp-action="UploadContent" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" required></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Type"></label>
        <select asp-for="Type" class="form-control" id="contentType" onchange="toggleUploadFields()" required>
            <option value="">Select content type</option>
            <option value="PDF">PDF</option>
            <option value="Video">Video</option>
            <option value="Link">Link/URL</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="form-group" id="urlField">
        <label asp-for="URL"></label>
        <input asp-for="URL" class="form-control" placeholder="Link to file or video" />
        <span asp-validation-for="URL" class="text-danger"></span>
    </div>

    <div class="form-group" id="uploadField" style="display: none;">
        <label for="uploadFile">Upload file</label>
        <input type="file" name="uploadFile" id="uploadFile" class="form-control" />
        <small class="form-text text-muted" id="uploadHint">Select a file to upload</small>
    </div>

    <div class="form-group">
        <label asp-for="CourseId">Course</label>
        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-control" required>
            <option value="">Select a course</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Upload</button>
</form>

<script>
function toggleUploadFields() {
    const typeSelect = document.getElementById('contentType');
    const selectedType = typeSelect.value;
    const urlField = document.getElementById('urlField');
    const uploadField = document.getElementById('uploadField');
    const uploadFileInput = document.getElementById('uploadFile');
    const uploadHint = document.getElementById('uploadHint');
    const urlInput = document.querySelector('input[name="URL"]');

    // Reset fields
    urlField.style.display = 'block';
    uploadField.style.display = 'none';
    uploadFileInput.removeAttribute('required');
    urlInput.removeAttribute('required');
    uploadFileInput.removeAttribute('accept');

    if (selectedType === 'PDF') {
        // Show upload field for PDF
        urlField.style.display = 'none';
        uploadField.style.display = 'block';
        uploadFileInput.setAttribute('required', 'required');
        uploadFileInput.setAttribute('accept', '.pdf');
        uploadHint.textContent = 'Select a PDF file to upload';
    } else if (selectedType === 'Video') {
        // Show upload field for Video
        urlField.style.display = 'none';
        uploadField.style.display = 'block';
        uploadFileInput.setAttribute('required', 'required');
        uploadFileInput.setAttribute('accept', '.mp4,.mov,.avi,.mkv,.webm');
        uploadHint.textContent = 'Select a video file to upload';
    } else if (selectedType === 'Link') {
        // Show URL field for Link
        urlField.style.display = 'block';
        uploadField.style.display = 'none';
        urlInput.setAttribute('required', 'required');
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    toggleUploadFields();
});
</script>
