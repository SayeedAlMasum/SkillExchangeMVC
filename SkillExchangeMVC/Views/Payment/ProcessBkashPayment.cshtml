@{
    ViewData["Title"] = "bKash Payment";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-center" style="background-color: #e2136e; color: white;">
                    <h3><i class="fas fa-mobile-alt"></i> bKash Payment</h3>
                </div>
                <div class="card-body text-center">
                    <h5>Course: @ViewBag.CourseName</h5>
                    <h4 class="text-success">Amount: ?@ViewBag.Amount</h4>
                    
                    <div class="mt-4">
                        <button id="bkashPayBtn" class="btn btn-lg" style="background-color: #e2136e; color: white;">
                            <i class="fas fa-mobile-alt"></i> Pay with bKash
                        </button>
                    </div>
                    
                    <div class="mt-3">
                        <a href="@Url.Action("CreatePayment", "Payment", new { courseId = ViewBag.CourseId })" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Payment Options
                        </a>
                    </div>
                    
                    <div id="loadingDiv" style="display: none;" class="mt-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                        <p class="mt-2">Processing payment...</p>
                    </div>

                    <div id="errorDiv" style="display: none;" class="mt-3">
                        <div class="alert alert-danger" id="errorMessage"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Add anti-forgery token *@
<form style="display: none;">
    @Html.AntiForgeryToken()
</form>

<script>
document.getElementById('bkashPayBtn').addEventListener('click', function() {
    const loadingDiv = document.getElementById('loadingDiv');
    const errorDiv = document.getElementById('errorDiv');
    const payBtn = document.getElementById('bkashPayBtn');
    
    // Hide error and show loading
    errorDiv.style.display = 'none';
    loadingDiv.style.display = 'block';
    payBtn.disabled = true;
    
    // Get anti-forgery token
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    // Create payment request
    fetch('@Url.Action("CreatePayment", "Bkash")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || ''
        },
        body: JSON.stringify({
            courseId: @ViewBag.CourseId,
            amount: @ViewBag.Amount,
            payerReference: '@ViewBag.PayerReference'
        })
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
    })
    .then(data => {
        console.log('Bkash API Response:', data);
        if (data.success && data.bkashURL) {
            // Redirect to bKash payment page
            window.location.href = data.bkashURL;
        } else {
            throw new Error(data.message || 'Payment initiation failed');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        document.getElementById('errorMessage').textContent = 'Payment initiation failed: ' + error.message;
        errorDiv.style.display = 'block';
        loadingDiv.style.display = 'none';
        payBtn.disabled = false;
    });
});
</script>