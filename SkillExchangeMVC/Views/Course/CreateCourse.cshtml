@* Course/CreateCourse.cshtml *@
@model CourseViewModel

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h3>Add New Course</h3>
<form method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Course.Title" class="form-label"></label>
                <input asp-for="Course.Title" class="form-control" required />
                <span asp-validation-for="Course.Title" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Course.Category" class="form-label"></label>
                <select asp-for="Course.Category" class="form-control" onchange="updateSubCategories()" required>
                    <option value="" disabled selected>Select a category</option>
                    <option value="Technical">Technical</option>
                    <option value="Creative">Creative</option>
                    <option value="Business">Business</option>
                    <option value="Personal Development">Personal Development</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Course.Category" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label for="SubCategory" class="form-label">Subcategory</label>
                <select id="SubCategory" asp-for="Course.SubCategory" class="form-control" required>
                    <option value="" disabled selected>Select a subcategory</option>
                </select>
                <span asp-validation-for="Course.SubCategory" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Course.TeacherId" class="form-label">Assign to Teacher</label>
                <select asp-for="Course.TeacherId" asp-items="Model.Teachers" class="form-control" required>
                    <option value="">Select a teacher</option>
                </select>
                <span asp-validation-for="Course.TeacherId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Course.Description" class="form-label"></label>
        <textarea asp-for="Course.Description" class="form-control" rows="3" required></textarea>
        <span asp-validation-for="Course.Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Course.Price" class="form-label">Course Price (৳)</label>
                <div class="input-group">
                    <span class="input-group-text">৳</span>
                    <input asp-for="Course.Price" type="number" step="0.01" min="0" class="form-control"
                        placeholder="0.00" />
                </div>
                <small class="form-text text-muted">Set to 0 for free courses. Only positive values allowed.</small>
                <span asp-validation-for="Course.Price" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <div class="form-check mt-4">
                    <input type="checkbox" asp-for="Course.IsPremium" class="form-check-input" />
                    <label asp-for="Course.IsPremium" class="form-check-label">Premium Course</label>
                </div>
                <small class="form-text text-muted">Premium courses get special features and priority support.</small>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="fas fa-save"></i> Save Course
    </button>
    <a href="@Url.Action("IndexCourse")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Courses
    </a>
</form>

<hr />

<!-- List of Available Courses -->
<h2>Available Courses</h2>
<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Course ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Sub Category</th>
                <th>Price (৳)</th>
                <th>Premium</th>
                <th>Teacher</th>
                <th>Operations</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Courses?.Any() ?? false)
            {
                @foreach (var item in Model.Courses)
                {
                    <tr>
                        <td>@item.CourseId</td>
                        <td>@item.Title</td>
                        <td>@item.Category</td>
                        <td>@item.SubCategory</td>
                        <td>
                            <span class="fw-bold text-success">৳@(item.Price ?? 0)</span>
                            @if (item.Price == 0 || item.Price == null)
                            {
                                <small class="text-muted">(Free)</small>
                            }
                        </td>
                        <td>
                            @if (item.IsPremium)
                            {
                                <span class="badge bg-warning text-dark">Premium</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Standard</span>
                            }
                        </td>
                        <td>
                            @{
                                var teacher = Model.Teachers?.FirstOrDefault(t => t.Value == item.TeacherId);
                            }
                            @(teacher?.Text ?? "Unknown")
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-controller="Course" asp-action="EditCourse" asp-route-id="@item.CourseId"
                                    class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-info"
                                    onclick="showPriceModal(@item.CourseId, '@item.Title', @(item.Price ?? 0))">
                                    <i class="fas fa-dollar-sign"></i> Price
                                </button>
                                <form method="post" asp-controller="Course" asp-action="Delete" asp-route-id="@item.CourseId"
                                    style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this course?')">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No courses available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Price Update Modal -->
<div class="modal fade" id="priceModal" tabindex="-1" aria-labelledby="priceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="priceModalLabel">Update Course Price</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="priceUpdateForm">
                    <input type="hidden" id="modalCourseId" />
                    <div class="form-group mb-3">
                        <label for="modalCourseTitle" class="form-label">Course:</label>
                        <input type="text" id="modalCourseTitle" class="form-control" readonly />
                    </div>
                    <div class="form-group mb-3">
                        <label for="modalPrice" class="form-label">New Price (৳):</label>
                        <div class="input-group">
                            <span class="input-group-text">৳</span>
                            <input type="number" id="modalPrice" step="0.01" min="0" class="form-control" required />
                        </div>
                        <small class="form-text text-muted">Set to 0 for free courses.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updatePrice()">Update Price</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Define subcategories for each main category
    const subCategories = {
        "Technical": ["Programming", "Networking", "AI and Machine Learning", "Cybersecurity"],
        "Creative": ["Graphic Design", "Photography", "Video Editing"],
        "Business": ["Finance", "Marketing", "Entrepreneurship"],
        "Personal Development": ["Leadership", "Time Management", "Public Speaking"],
        "Other": ["Miscellaneous"]
    };

    function updateSubCategories() {
        const category = document.getElementById("Course_Category").value;
        const subCategoryDropdown = document.getElementById("SubCategory");

        // Clear existing options
        subCategoryDropdown.innerHTML = '<option value="" disabled selected>Select a subcategory</option>';

        if (subCategories[category]) {
            subCategories[category].forEach(subCategory => {
                const option = document.createElement("option");
                option.value = subCategory;
                option.textContent = subCategory;
                subCategoryDropdown.appendChild(option);
            });
        }
    }

    // Price modal functions
    function showPriceModal(courseId, courseTitle, currentPrice) {
        document.getElementById('modalCourseId').value = courseId;
        document.getElementById('modalCourseTitle').value = courseTitle;
        document.getElementById('modalPrice').value = currentPrice;

        var modal = new bootstrap.Modal(document.getElementById('priceModal'));
        modal.show();
    }

    function updatePrice() {
        const courseId = document.getElementById('modalCourseId').value;
        const newPrice = document.getElementById('modalPrice').value;

        if (newPrice < 0) {
            alert('Price cannot be negative!');
            return;
        }

        fetch('@Url.Action("UpdatePrice", "Course")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: `courseId=${courseId}&price=${newPrice}`
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload(); // Refresh page to show updated price
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating the price.');
            });

        // Close modal
        var modal = bootstrap.Modal.getInstance(document.getElementById('priceModal'));
        modal.hide();
    }
</script>