@model SkillExchangeMVC.Models.Course
@{
    ViewData["Title"] = "Enroll Options";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-user-plus"></i> Enroll Options for @Model.Title</h4>
                </div>
                <div class="card-body">
                    @* Only show options for premium courses *@
                    @if (Model.IsPremium && Model.Price > 0)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> 
                            This is a premium course with a price of <strong>?@Model.Price</strong>. 
                            As an admin, you can choose to enroll with or without payment.
                        </div>
                        
                        <div class="d-grid gap-3">
                            <a class="btn btn-warning btn-lg" asp-controller="Payment" asp-action="CreatePayment" asp-route-courseId="@Model.CourseId">
                                <i class="fas fa-credit-card"></i> Payment (existing process)
                            </a>
                            <a class="btn btn-success btn-lg" asp-controller="Course" asp-action="AdminEnrollWithoutPayment" asp-route-id="@Model.CourseId">
                                <i class="fas fa-user-check"></i> Enroll without payment
                            </a>
                        </div>
                        
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="fas fa-lightbulb"></i> 
                                <strong>Tip:</strong> Choose "Enroll without payment" to bypass the payment process and directly access the course content.
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i> 
                            This is a free course. You should have been automatically enrolled and redirected to the course content.
                        </div>
                        <div class="d-grid">
                            <a class="btn btn-primary btn-lg" asp-controller="Content" asp-action="CourseContents" asp-route-courseId="@Model.CourseId">
                                <i class="fas fa-arrow-right"></i> Go to Course Content
                            </a>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("IndexCourse", "Course")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Courses
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
