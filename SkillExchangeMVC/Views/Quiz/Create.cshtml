@model SkillExchangeMVC.Models.Quiz
@{
    ViewData["Title"] = "Create Quiz";
}
<h2>Create Quiz</h2>
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="CourseId" />
    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>
    <div>
        <label asp-for="StartTime"></label>
        <input asp-for="StartTime" type="datetime-local" />
        <span asp-validation-for="StartTime"></span>
    </div>
    <div>
        <label asp-for="EndTime"></label>
        <input asp-for="EndTime" type="datetime-local" />
        <span asp-validation-for="EndTime"></span>
    </div>
    <div>
        <label asp-for="TotalMarks"></label>
        <input asp-for="TotalMarks" />
    </div>
    <div>
        <label>Is Exam?</label>
        <input asp-for="IsExam" type="checkbox" />
    </div>
    <button type="submit">Save</button>
</form>
